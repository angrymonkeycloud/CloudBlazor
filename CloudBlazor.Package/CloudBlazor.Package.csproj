<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Single packaging entry point for the whole repository.

		CloudPack treats this project as the metadata source: its <Version> and the
		properties listed in Program.cs are written into every target library before
		they are rebuilt, packed and pushed. Bump the version here — not in the
		individual libraries — to release all four packages together.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<RootNamespace>CloudBlazor.Package</RootNamespace>
		<AssemblyName>CloudBlazor.Package</AssemblyName>
		<IsPackable>false</IsPackable>
		<Authors>Angry Monkey</Authors>
		<Company>Angry Monkey</Company>
		<Version>1.0.1</Version>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<PackageIcon>amc-logo.png</PackageIcon>

		<UserSecretsId>f72da9d0-03f0-493e-83a6-d3b89db06438</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AngryMonkey.CloudMate" Version="1.3.6" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appconfig.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
