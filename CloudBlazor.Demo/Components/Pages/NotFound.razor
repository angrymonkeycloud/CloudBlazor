@page "/not-found"
@layout MainLayout
@inject CloudPage CloudPage

<PageIntro Package="404" Title="Page not found">
    That address does not match any page in this demo.
</PageIntro>

<div class="btn-row">
    <NavLink class="btn" href="">Back to overview</NavLink>
</div>

@code {
    protected override void OnInitialized() =>
        CloudPage
            .SetTitle("Page not found")
            .SetIndexPage(false);
}
