<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<AssemblyName>AngryMonkey.CloudBlazor</AssemblyName>
		<RootNamespace>AngryMonkey.CloudBlazor</RootNamespace>
		<PackageId>AngryMonkey.CloudBlazor</PackageId>

		<Product>Cloud Blazor</Product>
		<Description>Shared Blazor components and browser behaviors for static SSR, interactive Blazor, WebAssembly, and .NET MAUI Blazor Hybrid.</Description>
		<PackageTags>blazor;razor;components;webassembly;maui;ssr;angrymonkey</PackageTags>

		<Version>1.0.1</Version>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>

		<IsPackable>true</IsPackable>
	<Authors>Angry Monkey</Authors><Company>Angry Monkey</Company><PackageIcon>amc-logo.png</PackageIcon></PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
	</ItemGroup>

<ItemGroup><None Update="amc-logo.png"><Pack>True</Pack><PackagePath>\</PackagePath></None></ItemGroup></Project>
